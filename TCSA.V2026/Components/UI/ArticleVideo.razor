@using System.IO

@if (IsNativeVideo)
{
    <figure class="article-video">
        <video class="article-video-player"
               controls
               playsinline
               preload="metadata"
               aria-label="@Title">
            <source src="@Src" type="@MediaType" />
            Your browser does not support embedded video.
        </video>

        @if (!string.IsNullOrWhiteSpace(Caption))
        {
            <figcaption>@Caption</figcaption>
        }
    </figure>
}
else
{
    <div class="video-wrapper article-video">
        <iframe class="video-iframe"
                src="@Src"
                title="@Title"
                loading="lazy"
                allowfullscreen>
        </iframe>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Article video";
    [Parameter] public string? Caption { get; set; }

    private string Extension =>
        Path.GetExtension(Src.Split('?', '#')[0]).ToLowerInvariant();

    private bool IsNativeVideo =>
        Extension is ".mp4" or ".webm" or ".ogv";

    private string MediaType => Extension switch
    {
        ".webm" => "video/webm",
        ".ogv" => "video/ogg",
        _ => "video/mp4"
    };
}

<style>
    .article-video {
        width: min(100%, 960px);
        margin: 1.5rem auto;
    }

    .article-video-player {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        background: #111;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.16);
    }

    .article-video figcaption {
        margin-top: 0.65rem;
        color: var(--mud-palette-text-secondary);
        font-size: 0.9rem;
        text-align: center;
    }
</style>
