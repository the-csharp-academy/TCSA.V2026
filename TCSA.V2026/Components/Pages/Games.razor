@page "/games"
@using TCSA.V2026.Data.Models
@using TCSA.V2026.Services
@inject IGameService GameService

<PageTitle>Games | The C# Academy</PageTitle>

<MudContainer Class="py-6">
    <h1 class="mud-primary-text mt-3">Games</h1>
    <p class="mb-4 text-secondary mud-typography-body1">Explore games created by our community. Select a game to play.</p>

    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@loadError</MudAlert>
    }
    else if (games.Count == 0)
    {
        <MudText>No games are available yet.</MudText>
    }

    @if (TotalPages > 1)
    {
        <MudPagination Count="TotalPages" Selected="pageNumber" SelectedChanged="OnPageChanged" Class="mb-4" />
    }

    <MudGrid Spacing="6" Class="my-2">
        @foreach (var game in GamesOnPage)
        {
            <MudItem xs="12" sm="6" md="4" @key="game.Slug">
                <a href="@($"/games/{game.Slug}")" class="game-card-link">
                    <MudPaper Class="pa-3 rounded-lg elevation-3 game-card">
                        <div class="game-preview">
                            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Style="font-size: 64px;" />
                        </div>
                        <MudText Typo="Typo.h6" HtmlTag="h2" Color="Color.Primary" Class="mt-3">@game.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">@game.Description</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Played @game.TimesPlayed.ToString("N0") @(game.TimesPlayed == 1 ? "time" : "times")</MudText>
                        <MudText Typo="Typo.button" Color="Color.Primary" Class="mt-4">Play game →</MudText>
                    </MudPaper>
                </a>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private const int PageSize = 9;
    private int pageNumber = 1;
    private List<Game> games = [];
    private bool loading = true;
    private string? loadError;

    private int TotalPages => (int)Math.Ceiling(games.Count / (double)PageSize);

    private IEnumerable<Game> GamesOnPage => games
        .Skip((pageNumber - 1) * PageSize)
        .Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        var result = await GameService.GetGames();
        loading = false;

        if (result.IsFailure)
        {
            loadError = result.Message;

            return;
        }

        games = result.Value;
    }

    private void OnPageChanged(int page)
    {
        pageNumber = Math.Clamp(page, 1, Math.Max(1, TotalPages));
    }

}
