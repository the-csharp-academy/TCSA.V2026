@page "/games"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Games | The C# Academy</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudText Typo="Typo.h3" HtmlTag="h1" Class="mb-2">Games</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Try a browser game inside the academy. This preview is available to admins.</MudText>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-2">Button Challenge</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Click as many target buttons as you can within 30 seconds. Each hit earns a point.</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            If the game does not load,
            <a href="https://the-csharp-academy.github.io/Games.Unity.ButtonGame/Web/" target="_blank" rel="noopener noreferrer">open it in a new tab</a>.
        </MudText>
        <iframe src="https://the-csharp-academy.github.io/Games.Unity.ButtonGame/Web/"
                title="Button Challenge by The C# Academy"
                class="game-frame"
                height="1000"
                style="display: block; width: 100%; height: 1000px; border: 0;"
                sandbox="allow-scripts allow-same-origin"
                referrerpolicy="no-referrer"
                allowfullscreen>
        </iframe>
    </MudPaper>
</MudContainer>
