@page "/games/{Slug}"
@using TCSA.V2026.Data.Models
@using TCSA.V2026.Services
@inject IGameService GameService
@using TCSA.V2026.Components.UI

<PageTitle>@(game?.Title ?? "Game not found") | The C# Academy</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudButton Href="/games" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4">Back to games</MudButton>

    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@loadError</MudAlert>
    }
    else if (game is null)
    {
        <MudText Typo="Typo.h3" HtmlTag="h1">Game not found</MudText>
        <MudText Class="mt-2">Choose a game from the gallery.</MudText>
    }
    else
    {
        <GamePlayer Game="game" @key="game.Slug" />
    }
</MudContainer>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private Game? game;
    private bool loading = true;
    private string? loadError;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        loadError = null;
        game = null;
        var requestedSlug = Slug;
        var result = await GameService.GetGame(requestedSlug);

        if (requestedSlug != Slug)
        {
            return;
        }

        loading = false;

        if (result.IsSuccess)
        {
            game = result.Value;
        }
        else if (result.Reason.Code != "Game.NotFound")
        {
            loadError = result.Message;
        }
    }
}
