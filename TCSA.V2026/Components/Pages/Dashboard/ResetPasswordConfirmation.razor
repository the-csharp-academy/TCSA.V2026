@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset complete</PageTitle>

<section class="password-page" aria-labelledby="password-title">
    <div class="password-card">
        <div class="password-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Large" /></div>
        <p class="password-eyebrow">READY TO GO</p>
        <h1 id="password-title">You're all set</h1>
        <p class="password-description" role="status">Your password has been reset. Log in with your new password to continue your learning journey.</p>
        <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="password-submit">Back to log in</MudButton>
    </div>
</section>
