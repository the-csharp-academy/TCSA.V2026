@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email</PageTitle>

<section class="password-page" aria-labelledby="password-title">
    <div class="password-card">
        <div class="password-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Size="Size.Large" /></div>
        <p class="password-eyebrow">NEXT STEP</p>
        <h1 id="password-title">Check your inbox</h1>
        <p class="password-description" role="status">If an account with a confirmed email matches the address you entered, we'll send you a link to reset your password.</p>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Can't find it? Check your spam folder, or try again with the email you used to register.</MudText>
        <div class="password-footer"><MudLink Href="/Account/ForgotPassword">Try another email</MudLink><span aria-hidden="true"> &middot; </span><MudLink Href="/Account/Login">Back to log in</MudLink></div>
    </div>
</section>
