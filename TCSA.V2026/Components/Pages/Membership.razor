@page "/membership"
@page "/vip"
@using Microsoft.Extensions.Options
@using TCSA.V2026.Data.Models.Options
@rendermode RenderMode.InteractiveServer
@inject IOptions<LinksOptions> LinkOptions

<PageTitle>VIP Membership - The C# Academy</PageTitle>

<div class="membership-page">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-10 mb-10">
        <MudPaper Class="pa-10 membership-hero" Elevation="8">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="mb-4 membership-chip">VIP Membership</MudChip>
                    <MudText Typo="Typo.h2" HtmlTag="h1" Class="membership-title">The C# Academy Membership</MudText>
                    <MudText Typo="Typo.body1" Class="mt-4 membership-subtitle">Learn .NET and C# in depth with video tutorials, project solutions, and 1-on-1 mentorship.</MudText>
                    <MudStack Row="true" Spacing="3" Class="mt-8">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" StartIcon="@Icons.Material.Filled.School" Href="/membership#membership-plans" Class="membership-subscribe-btn">View Membership</MudButton>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex justify-center align-center">
                    <MudPaper Class="membership-hero-visual" Elevation="0">
                        <MudImage Src="/img/Banners/vipbanner.png" Alt="The C# Academy VIP Membership" ObjectFit="ObjectFit.Contain" Class="membership-hero-image" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-15 mb-10">
        <MudPaper id="membership-plans" Class="pa-8 membership-plans" Elevation="6">
            <MudText Typo="Typo.h4" HtmlTag="h2" Align="Align.Center" Class="mb-2 membership-heading">VIP Membership</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-8 membership-muted">All courses and personal support in one membership.</MudText>
            <MudGrid Spacing="3" Justify="Justify.Center">
                <MudItem xs="12" sm="8" md="6" lg="5" Class="d-flex">
                    <MudCard Class="membership-card d-flex fre
lex-column flex-grow-1" Elevation="4">
                        <MudCardMedia Image="/img/CourseImages/c1-ch1-oop-office.png" Height="200" Class="membership-card-image" role="img" aria-label="Programming workspace before and after organizing" />
                        <MudCardContent Class="flex-grow-1">
                            <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="membership-heading">$4.99</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4">per month</MudText>
                            <MudDivider Class="mb-4" />
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">All courses</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">1 Pair Programming Review per month</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">1 Mentorship session</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">Exclusive Discord Channel</MudListItem>
                            </MudList>
                        </MudCardContent>
                        <MudCardActions Class="pa-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="@MonthlyEnrollmentUrl">Subscribe Now</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-6">Price in USD. Enrollment and paid course access are hosted on LearnWorlds.</MudText>
        </MudPaper>
    </MudContainer>

    @foreach (var catalog in Catalogs)
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-15 mb-10">
            <MudText id="@catalog.Id" Typo="Typo.h4" HtmlTag="h2" Align="Align.Center" Class="mb-8 membership-heading">@catalog.Title</MudText>
            <MudGrid Spacing="3" Justify="Justify.Center">
                @foreach (var course in catalog.Courses)
                {
                    <MudItem xs="12" sm="6" md="4" Class="d-flex">
                        <MudCard Class="membership-card d-flex flex-column flex-grow-1" Elevation="6">
                            <MudCardMedia Image="@course.Image" Height="200" Class="membership-card-image" role="img" aria-label="@course.Title" />
                            <MudCardContent Class="text-center flex-grow-1">
                                <MudText Typo="Typo.h6" HtmlTag="h3" Align="Align.Center" Class="mt-4 mb-3 membership-course-title">@course.Title</MudText>
                                <MudText Typo="Typo.body2" Align="Align.Center">@course.Description</MudText>
                            </MudCardContent>
                            <MudCardActions Class="pa-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="@course.Url" aria-label="@($"View {course.Title} enrollment options")">View Course</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    }
</div>

<style>
    .membership-page {
        --mud-palette-primary: #0b102b;
        --mud-palette-primary-rgb: 124, 58, 237;
        --mud-palette-primary-darken: #6d28d9;
        --mud-palette-primary-lighten: #8b5cf6;
        --mud-palette-primary-text: #ffffff;
        --mud-palette-secondary: #c026d3;
        --mud-palette-secondary-rgb: 192, 38, 211;
        --mud-palette-success: #0e7490;
        --mud-palette-success-rgb: 14, 116, 144;
        --mud-palette-success-darken: #155e75;
        --mud-palette-success-lighten: #0891b2;
        --mud-palette-success-text: #ffffff;
        background: linear-gradient(160deg,
            color-mix(in srgb, #7c3aed 6%, var(--mud-palette-background)),
            var(--mud-palette-background) 55%,
            color-mix(in srgb, #22d3ee 5%, var(--mud-palette-background)));
        color: var(--mud-palette-text-primary);
        min-height: 100vh;
        padding: 20px 0;
    }
    .membership-page .membership-hero {
        --mud-palette-success: #22d3ee;
        --mud-palette-success-rgb: 34, 211, 238;
        --mud-palette-success-darken: #06b6d4;
        --mud-palette-success-lighten: #67e8f9;
        --mud-palette-success-text: #082f49;
        background: linear-gradient(125deg, #0b102b 0%, #171638 60%, #2c174b 100%);
        color: white;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
    }
    .membership-page .membership-title {
        font-weight: 700;
        font-size: 2.5rem;
        line-height: 1.2;
        color: white;
    }
    .membership-page .membership-subtitle { font-size: 1.1rem; line-height: 1.6; color: white; }
    .membership-page .membership-chip { width: fit-content; }
    .membership-page .membership-subscribe-btn { font-weight: 600; padding: 12px 32px; }
    .membership-page .membership-hero-visual {
        background: transparent;
        border-radius: 12px;
        width: 100%;
        padding: 0;
        overflow: hidden;
        line-height: 0;
        box-shadow: 0 0 0 1px rgba(103, 232, 249, 0.25);
    }
    .membership-page .membership-hero-image { display: block; width: 100%; height: auto; margin: 0; border-radius: 12px; }
    .membership-page .membership-plans {
        background: color-mix(in srgb, #7c3aed 5%, var(--mud-palette-surface));
        border: 1px solid color-mix(in srgb, #7c3aed 22%, var(--mud-palette-lines-default));
        border-radius: 12px;
    }
    .membership-page .membership-card {
        border-radius: 12px;
        width: 100%;
        border: 1px solid color-mix(in srgb, #0b102b 18%, var(--mud-palette-lines-default));
    }
    .membership-page .membership-plans .membership-card { border-top: 4px solid #c026d3; }
    .membership-page .membership-card-image { background-size: cover; background-position: center; background-color: var(--mud-palette-surface); }
    .membership-page .membership-course-title { font-size: 1.35rem; font-weight: 600; }
    .membership-page .membership-heading { font-weight: 600; }
    .membership-page .membership-muted { color: var(--mud-palette-text-secondary); }
    #membership-plans, #membership-tutorials, #membership-solutions { scroll-margin-top: 90px; }
    @@media (max-width: 600px) {
        .membership-page .membership-hero { padding: 32px 24px !important; }
        .membership-page .membership-title { font-size: 2rem; }
        .membership-page .membership-plans { padding: 24px 16px !important; }
    }
</style>
@code {
    private const string Provider = "https://thecsharpschool.getlearnworlds.com";
    private string EnrollmentOptions => string.IsNullOrWhiteSpace(LinkOptions.Value.VipMembership)
        ? Provider + "/subscription/the-c-academy-membership" : LinkOptions.Value.VipMembership;

    private const string MonthlyEnrollmentUrl = Provider + "/payment?product_id=the-c-academy-membership&type=subscription";

    private Catalog[] Catalogs => [
        new("membership-tutorials", "VIDEO COURSES", ".NET / C# tutorials", "Build a stronger foundation, then put it to work in real applications.", [
            new("ASP.NET Core Masterclass: From Fundamentals to Advanced", "Learn full-stack web development with feature-rich ASP.NET Core.", "ASP.NET CORE", "/img/CardImages/vip-aspnetcore.png", "#1c236d", EnrollmentOptions),
            new("ASP.NET Core Web APIs with Entity Framework", "Learn REST APIs while building an Airport Management System.", "WEB APIs", "/img/CardImages/vip-webapi.png", "#2f6f73", Provider + "/course/aspnet-core-web-apis"),
            new("Creating a Solid C# Foundation", "Develop a fully functional e-commerce application using C#.", "C# FOUNDATIONS", "/img/CardImages/vip-practical.png", "#832a77", EnrollmentOptions),
            new("Object Oriented Programming: Crash Course", "Learn the most used programming paradigm in web development.", "OBJECT ORIENTED", "/img/CardImages/vip-oop.png", "#c9436e", EnrollmentOptions),
            new("Visual Studio Code for C# Crash Course", "Set up your .NET/C# environment and create a small app to see your changes in action.", "VISUAL STUDIO CODE", "/img/CardImages/vip-vsc.png", "#2f6f73", EnrollmentOptions)
        ]),
        new("membership-solutions", "GUIDED PROJECT SOLUTIONS", "The C# Academy's solutions", "Follow detailed project walkthroughs and understand how the pieces fit together.", [
            new("Calculator", "Create a calculator with the help of Microsoft's documentation.", "CALCULATOR", "/img/CardImages/vip-calculator.png", "#832a77", EnrollmentOptions),
            new("Coding Tracker", "Track the hours you spend learning to code. Learn Dapper and basic object oriented programming.", "CODING TRACKER", "/img/CardImages/vip-codingtracker.png", "#2f6f73", EnrollmentOptions),
            new("Flashcards", "Work with linked databases using SQL Server and learn to use Data Transfer Objects.", "FLASHCARDS", "/img/CardImages/vip-flashcards.png", "#c9436e", EnrollmentOptions),
            new("Habit Logger", "Build a habit logger with SQLite and learn to get and validate user input.", "HABIT LOGGER", "/img/CardImages/vip-habitlogger.png", "#2f6f73", EnrollmentOptions),
            new("Math Game", "Create a math game and reinforce what you've learned in the Foundations area.", "MATH GAME", "/img/CardImages/vip-mathgame.png", "#1c236d", EnrollmentOptions)
        ])
    ];

    private sealed record Course(string Title, string Description, string Topic, string Image, string Accent, string Url);
    private sealed record Catalog(string Id, string Label, string Title, string Description, Course[] Courses);
}




